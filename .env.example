# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Halo tenant -------------------------------------------------------------
HALO_BASE_URL=https://yourtenant.haloitsm.com
HALO_AUTH_URL=https://yourtenant.haloitsm.com/auth/token
HALO_CLIENT_ID=
HALO_CLIENT_SECRET=

# If the service authenticates but sees ZERO assets, the cause is almost
# always the API application's PERMISSIONS, not its login mode.
#
# Measured against this tenant on 2026-09-18: a working integration and a
# broken one were both using "Application identity", so login mode was not
# the difference. The working one could see 31 asset types and the broken
# one could see 1. Compare the new application's permissions and asset-type
# visibility against an integration that already works, rather than changing
# the login mode first.
#
# tools/check_halo.py reports how many asset types and assets are visible,
# which is the fastest way to tell "no permission" from "nothing pending".

# --- Scope --------------------------------------------------------------------
# The four custom fields themselves are mapped in config/fields.yaml.
#
# The asset group holding the cable type records. Only records someone has
# deliberately placed in this group can ever trigger a print, regardless of
# what custom fields exist elsewhere in the tenant. Halo applies it (the
# assetgroup_id query parameter); tools/check_halo.py confirms Halo honoured
# it. Leave blank only if every visible asset should be in scope.
HALO_CABLE_ASSET_GROUP_ID=

HALO_TIMEOUT_SECONDS=10

# --- Operational -------------------------------------------------------------
POLL_INTERVAL_SECONDS=15
# How many cable types one poll may process. Nothing is dropped: the rest
# are picked up on the next poll a few seconds later, because nothing has
# been claimed yet.
#
# It exists to bound the blast radius, not the throughput. Each asset the
# service takes consumes its identifiers before anything prints, so if
# something is misconfigured this is how many ranges are burned before
# anyone can intervene. It also bounds how far ahead of the printer the
# queue can run: the agent paces jobs 60s apart, so ten jobs is ten minutes
# of printing handed over in one go.
#
# Raising it is safe for liveness -- the heartbeat is touched per asset, not
# per poll, so a long poll no longer trips the healthcheck -- but a bigger
# number means a bigger mistake if a cable type is set up wrong.
MAX_ASSETS_PER_POLL=10

# Labels printed per cable. 2 because both ends of a cable are labelled.
# A value of N cables consumes N identifiers and prints N * this many labels.
LABELS_PER_CABLE=2

# --- The print queue ---------------------------------------------------------
# Where the queue share appears INSIDE the container. This is a path, not the
# share's address -- the share itself is set by the SMB_* values below.
QUEUE_ROOT=/mnt/cable-queue
QUEUE_WRITE_RETRIES=3
QUEUE_WRITE_RETRY_SECONDS=5
FAILED_REMINDER_MINUTES=60

# The queue share on the Windows print host. Docker mounts it for the
# container (docker-compose.yml), so nothing is mounted on the Docker host.
# The share is //SMB_HOST/SMB_SHARE. Docker resolves SMB_HOST itself when it
# mounts the share, so use the print host's IP address if this machine cannot
# look its name up. install.ps1 on the print host writes
# queue-share.env; load it with:
#     python tools/import_share_config.py queue-share.env
# which fills these in and asks for the password.
SMB_HOST=
SMB_SHARE=CableLabelQueue
# An account on the print host, or a domain account with SMB_DOMAIN set.
# Guest access does not work: Windows refuses anonymous SMB by default.
# The password must not contain a comma (it would split the mount options).
# If you set it by hand, wrap it in single quotes: SMB_PASS='...'
SMB_USER=
SMB_PASS=
SMB_DOMAIN=

# --- The Last Label Run status field ----------------------------------------
# This field is read by people, so its timestamps are rendered in local time.
DISPLAY_TIMEZONE=UTC
# Truncate the status line to your Halo text field's limit. The status word
# and the identifier range are always preserved; only the failure reason is
# trimmed, and the full reason is always in the log.
STATUS_FIELD_MAX_CHARS=255
STATUS_WRITE_MAX_ATTEMPTS=5
# How long everything can go quiet before the service says so. If jobs are
# waiting and nothing has completed for this long, every waiting job's asset
# gets a STALLED line, so a print host that has gone away shows up in Halo
# instead of looking like "printing shortly". A long run is not a stall:
# each job that completes resets the clock.
STALLED_AFTER_MINUTES=30


# --- Safety valves -----------------------------------------------------------
# SHADOW_MODE logs the blocks it WOULD reserve and writes nothing to Halo.
# Run this first against a live tenant.
SHADOW_MODE=0
# DRY_RUN reserves and renders but does not enqueue. Consumes numbers.
DRY_RUN=0
LOG_LEVEL=INFO

# --- Paths ---------------------------------------------------------------------
# Where config/*.yaml is read from. Blank means the repo's config/ folder.
CONFIG_DIR=
# The single-instance lock. Two pollers would race on the same counters, so
# a second copy refuses to start while this file is locked.
LOCK_PATH=/tmp/halo-cable-label.lock
